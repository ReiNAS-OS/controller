{
  "name": "@reinas/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "reinas": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts serve --dev",
    "build": "TARGET=${TARGET:-bun-linux-x64} bun run scripts/build.ts"
  },
  "dependencies": {
    "@reinas/core": "workspace:*",
    "@reinas/server": "workspace:*",
    "@reinas/shared": "workspace:*"
  },
  "devDependencies": {
    "@reinas/web": "workspace:*"
  }
}
