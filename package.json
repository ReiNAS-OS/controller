{
  "name": "reinas-controller",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run build:web && bun run compile",
    "build:web": "bun run --cwd apps/web build",
    "compile": "bun run --cwd packages/cli compile",
    "check": "tsrs --noEmit --fast",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsrs": "^7.1.0-beta.tsrs5",
    "typescript": "^5.9.0"
  }
}
