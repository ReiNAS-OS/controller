{
  "name": "reinas-controller",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "turbo run build",
    "build:linux:x86_64": "TARGET=bun-linux-x64 turbo run build",
    "build:linux:arm64": "TARGET=bun-linux-arm64 turbo run build",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --fix-suggestions",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test --pass-with-no-tests",
    "test:linux": "bash scripts/container-test.sh",
    "test:vm-prepare": "bash scripts/vm-test.sh prepare",
    "test:vm-run": "bash scripts/vm-test.sh run",
    "test:vm-serve": "bash scripts/vm-test.sh serve",
    "test:vm-check": "bash scripts/vm-test.sh check",
    "test:vm-clean": "bash scripts/vm-test.sh clean",
    "dev:web": "bunx vite --config packages/web/vite.config.ts",
    "dev:api": "bun --watch apps/cli/src/main.ts serve",
    "typecheck": "tsrs --noEmit",
    "check": "bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "elysia": "^1.4.32",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsrs": "^7.1.0-beta.tsrs5",
    "turbo": "^2.11.13"
  },
  "packageManager": "bun@1.4.5"
}
