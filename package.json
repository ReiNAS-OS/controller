{
  "name": "reinas-controller",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix --fix-suggestions",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@elysia/static": "^1.4.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "elysia": "^1.4.32",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsrs": "^7.1.0-beta.tsrs5",
    "turbo": "^2.11.13"
  },
  "packageManager": "bun@1.4.5"
}
