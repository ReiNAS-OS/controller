{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["TARGET"]
    },
    "lint": {
      "outputs": []
    },
    "fmt": {
      "outputs": []
    }
  }
}
