{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "fmt": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": ["public/**"]
    }
  }
}
